+static void cmd_tcc(const char *file)
+{
+	LARGE_INTEGER t0, t1, fq;
+	QueryPerformanceFrequency(&fq);
+	QueryPerformanceCounter(&t0);
+	char dir[MAX_PATH], p[MAX_PATH + 32];
+	snprintf(dir, sizeof dir, "%s", file);
+	char *sl = strrchr(dir, '/');
+	if (sl)
+		*sl = 0;
+	TCCState *s = tcc_new();
+	snprintf(p, sizeof p, "%sck3", H->dir);
+	tcc_set_lib_path(s, p);
+	tcc_set_error_func(s, NULL, tcc_err);
+	snprintf(p, sizeof p, "%sck3/include", H->dir);
+	tcc_add_sysinclude_path(s, p);
+	tcc_add_include_path(s, dir);
+	tcc_set_options(s, "-nostdlib");
+	tcc_set_output_type(s, TCC_OUTPUT_MEMORY);
+	tcc_add_symbol(s, "memset", memset);
+	tcc_add_symbol(s, "memcpy", memcpy);
+	tcc_add_symbol(s, "memmove", memmove);
+	snprintf(p, sizeof p, "%sck3/lib/libtcc1.a", H->dir);
+	const ck3_plugin *(*start)(const ck3_api *) = NULL;
+	if (tcc_add_file(s, file) < 0 || tcc_add_file(s, p) < 0 || tcc_relocate(s) < 0 ||
+	    !(start = tcc_get_symbol(s, "ck3_plugin_start"))) {
+		tcc_delete(s);
+		LOG("tcc: %s recusado; plugin anterior %s", file, tcc_pl ? "mantido" : "(nenhum)");
+		return;
+	}
+	const ck3_plugin *pl = start(&TCC_API);
+	TCCState *old = tcc_s;
+	tcc_pl = pl;
+	tcc_s = s;
+	if (old)
+		tcc_delete(old);
+	QueryPerformanceCounter(&t1);
+	LOG("tcc: %s compilado e carregado em %.1f ms", file, (double)(t1.QuadPart - t0.QuadPart) * 1000.0 / (double)fq.QuadPart);
+}
